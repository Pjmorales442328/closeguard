VULTR_API_KEY=
VULTR_INFERENCE_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# writer/: role passwords are applied by writer.db.apply_schema(); DSNs used by post_entries / verify_run
CG_WRITER_PASSWORD=
CG_READER_PASSWORD=
CG_WRITER_DSN=host=db dbname=closeguard user=cg_writer password=
CG_READER_DSN=host=db dbname=closeguard user=cg_reader password=
CG_VOICE_LIVE_PER_HOUR=60

# Vultr Object Storage for the evidence vault (optional; without it the vault says it is not set up)
CG_S3_ENDPOINT=https://ewr1.vultrobjects.com
CG_S3_ACCESS_KEY=
CG_S3_SECRET_KEY=
CG_S3_BUCKET=closeguard-evidence
